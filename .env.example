ASSEMBLYAI_API_KEY=your_api_key_here
# Optional: enables live web search + page reading (search_live / scrape_live) via Anakin.io
ANAKIN_API_KEY=
# Machine or app manifest. The Field demo uses the sample extruder; leave blank for Netra Desktop.
NETRA_MANIFEST=manifests/sample-machine.yaml
# 'model' (3D Field viewer) or 'screen' (Desktop OCR). Blank = inferred from the manifest domain.
NETRA_SIGHT=
# 1 = start the voice agent immediately instead of waiting for "Hey Netra"
NETRA_AUTOSTART=0
